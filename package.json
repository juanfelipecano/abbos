{
  "name": "abbos",
  "version": "0.0.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:host": "ng serve --host=0.0.0.0 playground",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:abbos": "ng build abbos",
    "build:abbos:watch": "ng build abbos --watch",
    "abbos:yalc:publish": "yalc publish dist/abbos",
    "abbos:yalc:watch": "chokidar \"dist/abbos/**/*\" --debounce 500 -c \"yalc publish --push\"",
    "dev": "concurrently \"npm:build:abbos:watch\" \"npm:start:host\""
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@lucide/angular": "^1.47.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@vitest/coverage-v8": "^4.1.10",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
